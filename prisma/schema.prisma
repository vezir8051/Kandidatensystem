// Prisma-Schema für TempMatch.
// PostgreSQL (Vercel Postgres in Produktion, lokal via DATABASE_URL).
// Enum-Felder werden als String gespeichert (Union-Typen in src/lib/types.ts),
// Listen als JSON-String – so bleibt das Mapping in src/lib/db.ts portabel.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Firma {
  id            String    @id @default(cuid())
  name          String
  branche       String
  ort           String
  kontaktperson String
  inserate      Inserat[]
  createdAt     DateTime  @default(now())
}

model Agentur {
  id            String     @id @default(cuid())
  name          String
  ort           String
  kontaktperson String
  aboAktiv      Boolean    @default(false)
  kandidaten    Kandidat[]
  createdAt     DateTime   @default(now())
}

model Inserat {
  id                     String     @id @default(cuid())
  firma                  Firma      @relation(fields: [firmaId], references: [id])
  firmaId                String
  titel                  String
  beruf                  String
  beschreibung           String
  anforderungen          String     @default("[]") // JSON-Array von Strings
  ort                    String
  startDatum             String
  dauer                  String
  festanstellungMoeglich Boolean    @default(false)
  status                 String     @default("OFFEN")
  erstelltAm             String
  kandidaten             Kandidat[]
  createdAt              DateTime   @default(now())
}

model Kandidat {
  id                   String    @id @default(cuid())
  inserat              Inserat   @relation(fields: [inseratId], references: [id])
  inseratId            String
  agentur              Agentur   @relation(fields: [agenturId], references: [id])
  agenturId            String
  vorname              String
  nachname             String
  beruf                String
  erfahrungJahre       Int
  qualifikationen      String    @default("[]") // JSON-Array von Strings
  verfuegbarAb         String
  verfuegbarBis        String?
  telefon              String?
  email                String?
  fruehererArbeitgeber String?
  status               String    @default("AUSSTEHEND")
  notiz                String
  // Pflichtbestätigungen bei der Einreichung (nDSG-Audit).
  consentNdsg          Boolean   @default(false)
  consentWahrheit      Boolean   @default(false)
  consentErreichbar    Boolean   @default(false)
  consentAm            DateTime?
  // Lebenslauf als PDF, direkt in der DB gespeichert (bytea).
  cvDateiname          String?
  cvInhalt             Bytes?
  meldungen            Meldung[]
  createdAt            DateTime  @default(now())
}

// Meldung eines Kandidaten durch eine Firma (Missbrauch/Beschwerde).
model Meldung {
  id         String   @id @default(cuid())
  kandidat   Kandidat @relation(fields: [kandidatId], references: [id])
  kandidatId String
  grund      String
  createdAt  DateTime @default(now())
}

// Frühbucher-/Warteliste von der Startseite (Lead-Formular).
model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  rolle     String // "Firma" oder "Vermittlungsbüro"
  createdAt DateTime @default(now())
}
